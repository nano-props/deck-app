{
  "name": "deck-app",
  "version": "0.1.2",
  "description": "Desktop container for .deck presentations",
  "private": true,
  "type": "module",
  "main": "src/main/main.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green 'vite build --watch --mode development' 'electron .'",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "vite build && electron .",
    "build": "bun scripts/build.ts",
    "build:renderer": "vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:electron": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish": "bun scripts/publish.ts",
    "deploy": "bun scripts/deploy.ts",
    "pack:deck": "bun scripts/pack-deck.ts",
    "clean": "rm -rf dist release"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/adm-zip": "0.5.8",
    "@types/bun": "1.3.14",
    "@types/dompurify": "3.2.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/serve-static": "2.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "electron": "42.0.1",
    "electron-builder": "26.8.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.12"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "adm-zip": "0.5.17",
    "chokidar": "5.0.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "3.4.3",
    "jszip": "3.10.1",
    "lucide-react": "1.14.0",
    "marked": "18.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "serve-static": "2.2.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "zustand": "5.0.13"
  }
}
