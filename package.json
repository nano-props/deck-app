{
  "name": "deck-app",
  "version": "0.1.1",
  "description": "Desktop container for .deck presentations",
  "private": true,
  "type": "module",
  "main": "src/main/main.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite build --watch --mode development\" \"electron .\"",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "pack:deck": "bun scripts/pack-deck.ts",
    "build:app": "bun scripts/build.ts",
    "build:electron": "electron-builder",
    "publish": "bun scripts/publish.ts",
    "clean": "bun scripts/clean.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/adm-zip": "0.5.8",
    "@types/bun": "1.3.13",
    "@types/dompurify": "3.2.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/serve-static": "2.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "electron": "42.0.0",
    "electron-builder": "26.8.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "vite": "8.0.10"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.0",
    "@mariozechner/pi-ai": "0.73.0",
    "@mariozechner/pi-coding-agent": "0.73.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "adm-zip": "0.5.17",
    "chokidar": "5.0.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "3.4.2",
    "lucide-react": "1.14.0",
    "marked": "18.0.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "serve-static": "2.2.1",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "zustand": "5.0.13"
  }
}
